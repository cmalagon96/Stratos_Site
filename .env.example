# =============================================================================
# Stratos Site — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Get this from https://console.neon.tech → project → connection details
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/stratos?sslmode=require

# ---------------------------------------------------------------------------
# Stripe (Payments)
# ---------------------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Stripe CLI: stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------------------------------------------------------------------------
# Upstash Redis (Rate Limiting & Caching)
# ---------------------------------------------------------------------------
# Console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ---------------------------------------------------------------------------
# Keygen.sh (License Management)
# ---------------------------------------------------------------------------
# Dashboard: https://app.keygen.sh
KEYGEN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
KEYGEN_PRODUCT_TOKEN=xxx
# Webhook signing public key (hex-encoded Ed25519) from Keygen dashboard
KEYGEN_WEBHOOK_SIGNING_KEY=xxx
# Policy IDs from Keygen dashboard (one per product type)
KEYGEN_POLICY_SAAS=00000000-0000-0000-0000-000000000000
KEYGEN_POLICY_DESKTOP=00000000-0000-0000-0000-000000000000
KEYGEN_POLICY_CLI=00000000-0000-0000-0000-000000000000
KEYGEN_POLICY_TEMPLATE=00000000-0000-0000-0000-000000000000
KEYGEN_POLICY_REPORT=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# S3 (Product File Downloads — set automatically by SST in deployed envs)
# ---------------------------------------------------------------------------
# For local dev, set this to your SST bucket name
# S3_BUCKET_NAME=stratos-site-productfiles-xxx

# ---------------------------------------------------------------------------
# Resend (Transactional Email)
# ---------------------------------------------------------------------------
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# ---------------------------------------------------------------------------
# PostHog (Analytics — Phase 7)
# ---------------------------------------------------------------------------
# Dashboard: https://app.posthog.com/project/settings → Project API Key
# Cookie-free mode is enabled by default (persistence: 'memory')
# Analytics are disabled when browser DNT=1 is detected
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Crisp Chat (Support Widget — Phase 7)
# ---------------------------------------------------------------------------
# Dashboard: https://app.crisp.chat → Website Settings → Setup Instructions
# Only loads on marketing pages (not dashboard/admin)
NEXT_PUBLIC_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Termly (Legal Docs — Phase 7)
# ---------------------------------------------------------------------------
# Dashboard: https://app.termly.io → your policy → Embed
# Omit to use built-in fallback copy
NEXT_PUBLIC_TERMLY_PRIVACY_ID=
NEXT_PUBLIC_TERMLY_TERMS_ID=

# ---------------------------------------------------------------------------
# Better Auth (Authentication)
# ---------------------------------------------------------------------------
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=http://localhost:4000
# Passkey RP ID (production domain, e.g. stratos.dev)
# PASSKEY_RP_ID=stratos.dev

# ---------------------------------------------------------------------------
# App Configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:4000
